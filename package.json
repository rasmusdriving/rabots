{
  "name": "pobots",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Rasmus Driving",
  "description": "A desktop home for persistent bots",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "deps": "node scripts/install.mjs",
    "build": "node scripts/build.mjs",
    "build:engine": "node scripts/build.mjs engine",
    "build:ui": "node scripts/build.mjs ui",
    "build:desktop": "node scripts/build.mjs desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "start": "node scripts/build.mjs && electron .",
    "engine": "node scripts/build.mjs engine && node dist/engine/main.mjs",
    "service:install": "node scripts/build.mjs && node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "check:engine": "node scripts/build.mjs engine && node scripts/engine-smoke.mjs",
    "check:app": "node scripts/build.mjs && node scripts/check-all.mjs app",
    "check:remote": "node scripts/build.mjs && node scripts/remote-check.mjs",
    "check:ui": "node scripts/build.mjs ui && node scripts/check-all.mjs ui",
    "live:update": "node scripts/build.mjs && node scripts/live-update.mjs request",
    "live:status": "node scripts/live-update.mjs status",
    "testbed:update": "node scripts/build.mjs && node scripts/live-update.mjs request --test-copy",
    "testbed:install": "node scripts/build.mjs && node scripts/testbed.mjs install",
    "testbed:status": "node scripts/testbed.mjs status",
    "testbed:reset": "node scripts/build.mjs && node scripts/testbed.mjs reset",
    "test": "cd engine && node --test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "44.9.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
